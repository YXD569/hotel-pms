# ===== 本地开发环境变量示例 =====
# 复制本文件为 backend/.env 后填写；.env 已被根 .gitignore 忽略，不会进仓库。

# 本地联调用 SQLite（无需安装数据库，开箱即用）：
DATABASE_URL=sqlite+pysqlite:///./hotel_pms.db

# 若本地有 MySQL，改用：
# DATABASE_URL=mysql+pymysql://root:root@localhost:3306/hotel_pms?charset=utf8mb4

# Railway 部署：MySQL 插件会自动注入连接串。
#   - 旧版 / 手动填：DATABASE_URL=mysql://...（后端会转换为 mysql+pymysql://）
#   - 新版 Railway MySQL 插件：注入的是 MYSQL_URL（mysql://...），后端已内置回退，无需手填。
# 二者都不必手填，后端会优先使用注入值，缺省则回退到下方 SQLite 本地默认值。

# JWT 签名密钥（生产务必换成随机长字符串，至少 32 字节）
JWT_SECRET=dev-only-secret-please-change-in-production-32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 前端静态目录（默认项目根，含 index.html；部署时由 Railway 工作目录决定，一般无需修改）
# FRONTEND_DIR=..

# 开发跨域来源（Railway 同源部署可不填；本地分离端口调试时填写前端地址）
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
