{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PMS 后端（8000，可断点）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "后端测试 test_api.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/test_api.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
